# Base URL of the Content Automation API (include /api/v1).
# Local backend:  http://localhost:5000/api/v1
NEXT_PUBLIC_API_BASE_URL=https://content-automation-backend-jwpw.onrender.com/api/v1

# Optional public demo account. Use a dedicated, non-admin account only.
# These values are exposed to every visitor; never use personal credentials.
NEXT_PUBLIC_DEMO_LOGIN_ENABLED=false
NEXT_PUBLIC_DEMO_EMAIL=
NEXT_PUBLIC_DEMO_PASSWORD=
